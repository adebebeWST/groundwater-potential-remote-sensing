# ─── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Database (SQL Server – WST Framework default)
DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourPassword123!
DB_DATABASE=groundwater_sdss

# Optional: use PostgreSQL + PostGIS for groundwater queries
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=gw_user
# DB_PASSWORD=secure_password
# DB_DATABASE=groundwater_sdss

# JWT configuration
JWT_SECRET=change-me-in-production-32-chars-minimum
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# GEE Service Account (download JSON from Google Cloud Console)
GEE_PRIVATE_KEY_PATH=/secrets/gee-service-account.json
GEE_PROJECT_ID=mowe-groundwater

# Tile / GeoServer configuration
GEOSERVER_URL=http://geoserver:8080/geoserver/gwc/service/wmts
RASTER_TILE_BASE_URL=https://tiles.example.com

# Redis (optional caching / rate limiting)
REDIS_URL=redis://localhost:6379

# Email (MailerSend – used by report service)
API_KEY_MAILERSEND=

# Crypto
KEY=
IV=

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Copy these into client/.env (not tracked by git)
VITE_API_BASE_URL=http://localhost:3001/api
VITE_RASTER_TILE_BASE_URL=https://tiles.example.com
VITE_MAPBOX_TOKEN=optional_for_satellite_basemap
