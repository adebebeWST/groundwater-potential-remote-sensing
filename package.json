{
  "name": "auth-wsthub-services",
  "version": "1.0.1",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "cross-env NODE_ENV=production npx tsc --project tsconfig.json && npx tsc-alias && npx tsc-esm-fix dist",
    "production": "NODE_ENV=production node dist/server.js",
    "test": "yarn test:unit && yarn test:int && yarn test:e2e && yarn posttest",
    "test:unit": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --coverageDirectory=coverage/unit --testMatch \"**/*.unit.spec.ts\" --detectOpenHandles",
    "test:int": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --coverageDirectory=coverage/int --testMatch \"**/*.int.spec.ts\" --detectOpenHandles --passWithNoTests",
    "test:e2e": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --coverageDirectory=coverage/e2e --testMatch \"**/*.e2e.spec.ts\" --detectOpenHandles --passWithNoTests",
    "posttest": "node ./scripts/merge-coverage.cjs",
    "start": "node dist/server.js",
    "start:lambda": "npx serverless offline",
    "migrate": "tsx scripts/run-migration.ts"
  },
  "dependencies": {
    "@nestjs/swagger": "^11.1.5",
    "@vendia/serverless-express": "^4.12.6",
    "@wst/core": "file:../wst-core",
    "@wst/database": "file:../wst-database",
    "@wst/logger": "file:../wst-logger",
    "@wst/middleware": "file:../wst-middleware",
    "@wst/security": "file:../wst-security",
    "auth-wsthub-services": "file:",
    "axios": "^1.7.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "connect-timeout": "^1.9.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.11",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "mailersend": "^2.2.0",
    "module-alias": "^2.2.2",
    "mssql": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.4",
    "tsyringe": "^4.8.0",
    "typeorm": "^0.3.20",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/plugin-proposal-decorators": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-typescript": "^7.23.3",
    "@gjsify/esbuild-plugin-transform-ext": "^0.0.4",
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^4.17.17",
    "@types/express-serve-static-core": "^4.17.33",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.16.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.25.3",
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "serverless": "^4.14.2",
    "serverless-offline": "^14.4.0",
    "ts-jest": "29.1.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsc-esm-fix": "^3.1.2",
    "tsc-init": "^2.1.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
